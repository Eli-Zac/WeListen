{
  "name": "welisten",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev:server": "pnpm --filter @welisten/server dev",
    "dev:extension": "pnpm --filter @welisten/extension dev",
    "test": "pnpm -r test",
    "test:sim": "pnpm --filter @welisten/server test:sim",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint ."
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd"]
  }
}
